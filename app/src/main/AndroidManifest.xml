<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Caméra -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- NFC : lecture des cartes d'agents (required=false : l'app reste installable sans NFC) -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Réseau (obligatoire pour charger les tuiles Google Maps) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Géolocalisation -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications push (FCM) — Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Stockage — lecture des images de la galerie -->
    <!-- Android 13+ (API 33) : READ_MEDIA_IMAGES remplace READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android ≤ 12 : READ_EXTERNAL_STORAGE (ignoré automatiquement sur API 33+) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Permissions personnalisées du ContentProvider des rapports -->
    <permission
        android:name="com.example.citoyenactif.permission.READ_REPORTS"
        android:description="@string/perm_read_reports_desc"
        android:label="@string/perm_read_reports_label"
        android:protectionLevel="signature" />
    <permission
        android:name="com.example.citoyenactif.permission.WRITE_REPORTS"
        android:description="@string/perm_write_reports_desc"
        android:label="@string/perm_write_reports_label"
        android:protectionLevel="signature" />

    <application
        android:name=".CitoyenActifApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CitoyenActif.NoActionBar"
        tools:targetApi="31">

        <!--
            CLÉ API GOOGLE MAPS
            La valeur est lue depuis res/values/strings.xml → google_maps_key
            Remplacez "YOUR_GOOGLE_MAPS_API_KEY_HERE" dans strings.xml
            par la clé obtenue sur https://console.cloud.google.com/
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <activity
            android:name=".ui.authentification.AuthentificationActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Écran de connexion par carte NFC (agents municipaux) -->
        <activity
            android:name=".ui.authentification.NfcScanActivity"
            android:exported="false"
            android:theme="@style/Theme.CitoyenActif.NoActionBar" />

        <!-- Écran de programmation des cartes NFC -->
        <activity
            android:name=".ui.authentification.NfcWriteActivity"
            android:exported="false"
            android:theme="@style/Theme.CitoyenActif.NoActionBar" />

        <activity
            android:name=".ui.citizen.CitizenPageActivity"
            android:theme="@style/Theme.CitoyenActif.NoActionBar" />

        <activity
            android:name=".ui.report.ReportActivity"
            android:theme="@style/Theme.CitoyenActif.NoActionBar" />

        <activity
            android:name=".ui.municipal.MunicipalPageActivity"
            android:theme="@style/Theme.CitoyenActif.NoActionBar" />

        <!-- ══════════════════════════════════════════════════════════════
             SERVICE FCM — notifications push (bonus +5)
             Reçoit les messages Firebase Cloud Messaging en foreground.
             ══════════════════════════════════════════════════════════════ -->
        <service
            android:name=".service.CitoyenMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Canal de notification par défaut (affiché si non spécifié dans le payload) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="citoyen_actif_channel" />

        <!-- FileProvider pour la caméra -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            CONTENT PROVIDER — interopérabilité avec les autres applications du citoyen.
            exported=true : les autres apps peuvent l'appeler, mais seulement avec
            la permission de lecture (query) ou d'écriture (insert) ci-dessus.
        -->
        <provider
            android:name=".provider.ReportProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true"
            android:readPermission="com.example.citoyenactif.permission.READ_REPORTS"
            android:writePermission="com.example.citoyenactif.permission.WRITE_REPORTS" />

    </application>

</manifest>
