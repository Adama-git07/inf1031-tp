<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <!-- Le ViewModel fournit le message affiché (liaison DataBinding) -->
        <variable
            name="viewModel"
            type="com.example.citoyenactif.ui.viewmodel.NfcScanViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/uqtr_green"
        android:padding="24dp">

        <!-- Titre -->
        <TextView
            android:id="@+id/tvNfcTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activer mon compte"
            android:textColor="@color/uqtr_white"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvNfcStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Message d'état : lié au ViewModel, il change tout seul -->
        <TextView
            android:id="@+id/tvNfcStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@{viewModel.status}"
            android:textColor="@color/uqtr_white"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/btnNfcSettings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNfcTitle" />

        <!-- Visible seulement si le NFC est désactivé -->
        <Button
            android:id="@+id/btnNfcSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/uqtr_gold"
            android:text="Ouvrir les paramètres NFC"
            android:textColor="@color/uqtr_white"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNfcStatus" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>