<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="dto"
            type="com.example.citoyenactif.model.dto.ReportCreateDTO" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Titre dynamique (Ajouter / Détails / Modifier) -->
            <TextView
                android:id="@+id/tvReportFormTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajouter un rapport"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textAlignment="center"
                android:paddingTop="8dp"
                android:paddingBottom="12dp" />

            <!-- Champ Titre — lié two-way à dto.title -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Titre du rapport">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@={dto.title}" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Champ Description — lié two-way à dto.description -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Description">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:inputType="textMultiLine"
                    android:text="@={dto.description}" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Catégorie -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Catégorie">

                <Spinner
                    android:id="@+id/spCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/report_categories"
                    android:selectedItemPosition="@={dto.categoryPosition}" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ── Section Localisation ───────────────────────────────── -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Localisation"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Position non définie"
                android:textColor="#757575"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGetLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍  Obtenir ma position"
                app:backgroundTint="#0277BD"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <!-- ── Section Photos ──────────────────────────────────────── -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Photos"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Défilement horizontal des photos (Fix #8) -->
            <HorizontalScrollView
                android:id="@+id/hsvPhotos"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:scrollbars="none">

                <!-- Les photos sont ajoutées dynamiquement ici par le code Java -->
                <LinearLayout
                    android:id="@+id/llPhotos"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

            </HorizontalScrollView>

            <!-- Bouton Prendre une photo (caché en mode VIEW) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTakePhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📷  Ajouter une photo"
                app:backgroundTint="#1565C0"
                android:textColor="@android:color/white" />

            <!-- ── Section Statut (visible uniquement en mode VIEW) ──────── -->

            <LinearLayout
                android:id="@+id/llStatusSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Statut"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Affiché uniquement si RESOLU -->
                <LinearLayout
                    android:id="@+id/llResolvedDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvResolvedByAgent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#424242"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Photo de preuve"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <ImageView
                        android:id="@+id/ivResolvedProof"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="8dp" />

                </LinearLayout>

                <!-- Affiché uniquement si IGNORE -->
                <LinearLayout
                    android:id="@+id/llIgnoredDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvIgnoredByAgent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#424242"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Raison"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvIgnoreReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#424242" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Boutons d'action ─────────────────────────────────────── -->

            <LinearLayout
                android:id="@+id/llButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <!-- Annuler (toujours visible) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelReport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Annuler"
                    app:backgroundTint="#D32F2F"
                    android:textColor="@android:color/white" />

                <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                <!-- Modifier (visible seulement en mode VIEW) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditReport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Modifier"
                    android:visibility="gone"
                    app:backgroundTint="#F57F17"
                    android:textColor="@android:color/white" />

                <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                <!-- Enregistrer (visible en CREATE et EDIT, caché en VIEW) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveReport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enregistrer"
                    app:backgroundTint="#1B5E20"
                    android:textColor="@android:color/white" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>
</layout>