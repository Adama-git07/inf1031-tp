<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="dto"
            type="com.example.citoyenactif.model.dto.ResetPasswordDTO" />
    </data>

    <!-- Fond vert UQTR -->
    <ScrollView
        android:id="@+id/reset_password_frag"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/uqtr_green"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Icône localisation -->
            <ImageView
                android:id="@+id/ivLocationPin"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_location_pin"
                android:layout_marginTop="36dp"
                android:contentDescription="Icône localisation"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Titre app -->
            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Citoyen Actif"
                android:textColor="@color/uqtr_white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/ivLocationPin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Ligne décorative dorée -->
            <View
                android:id="@+id/dividerGold"
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:background="@color/uqtr_gold"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Carte blanche formulaire -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/uqtr_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toBottomOf="@id/dividerGold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Titre section -->
                    <TextView
                        android:id="@+id/titre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Réinitialiser le mot de passe"
                        android:textColor="@color/uqtr_green"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="20dp" />

                    <!-- Nom d'utilisateur -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nom d'utilisateur"
                        app:boxStrokeColor="@color/uqtr_green"
                        app:hintTextColor="@color/uqtr_green">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/username"
                            android:text="@={dto.username}"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nouveau mot de passe -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nouveau mot de passe"
                        android:layout_marginTop="12dp"
                        app:boxStrokeColor="@color/uqtr_green"
                        app:hintTextColor="@color/uqtr_green"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/uqtr_green">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password"
                            android:text="@={dto.password}"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirmer mot de passe -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Confirmez votre mot de passe"
                        android:layout_marginTop="12dp"
                        app:boxStrokeColor="@color/uqtr_green"
                        app:hintTextColor="@color/uqtr_green"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/uqtr_green">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/confirm_password"
                            android:text="@={dto.confirmPassword}"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Boutons ANNULER / CONFIRMER -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp">

                        <Button
                            android:id="@+id/cancel_button"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="ANNULER"
                            android:textColor="@color/uqtr_white"
                            android:textStyle="bold"
                            android:backgroundTint="@color/text_secondary" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="wrap_content" />

                        <Button
                            android:id="@+id/confirm_button"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="CONFIRMER"
                            android:textColor="@color/uqtr_white"
                            android:textStyle="bold"
                            android:backgroundTint="@color/uqtr_gold" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>