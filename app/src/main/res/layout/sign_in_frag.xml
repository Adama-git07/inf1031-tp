<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <!-- Fond vert UQTR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/uqtr_green">

        <!-- ══════════════════════════════════════════════════
             ZONE EN-TÊTE : icône localisation + titre
             ══════════════════════════════════════════════════ -->

        <!-- Icône localisation (pin blanc) -->
        <ImageView
            android:id="@+id/ivLocationPin"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_location_pin"
            android:layout_marginTop="48dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Icône localisation" />

        <!-- Titre "Citoyen Actif" -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Citoyen Actif"
            android:textColor="@color/uqtr_white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ivLocationPin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Sous-titre / accroche -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Votre ville, votre voix"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ligne décorative dorée -->
        <View
            android:id="@+id/dividerGold"
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:background="@color/uqtr_gold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ══════════════════════════════════════════════════
             CARTE BLANCHE : formulaire de connexion
             ══════════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardBackgroundColor="@color/uqtr_white"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/dividerGold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Titre section -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connexion"
                    android:textColor="@color/uqtr_green"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- Choix du type de compte -->
                <RadioGroup
                    android:id="@+id/rgAccountType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbCitizen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Citoyen"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/uqtr_green"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbAgent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agent municipal"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/uqtr_green"
                        android:layout_marginStart="24dp" />
                </RadioGroup>

                <!-- ── Formulaire Citoyen ── -->
                <LinearLayout
                    android:id="@+id/citizenForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsername"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nom d'utilisateur ou email"
                        app:boxStrokeColor="@color/uqtr_green"
                        app:hintTextColor="@color/uqtr_green">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Mot de passe"
                        android:layout_marginTop="12dp"
                        app:boxStrokeColor="@color/uqtr_green"
                        app:hintTextColor="@color/uqtr_green"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/uqtr_green">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- ── Formulaire Agent ── -->
                <LinearLayout
                    android:id="@+id/agentForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAgentNumber"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Numéro d'agent"
                        app:boxStrokeColor="@color/uqtr_green"
                        app:hintTextColor="@color/uqtr_green">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAgentNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAgentPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Mot de passe"
                        android:layout_marginTop="12dp"
                        app:boxStrokeColor="@color/uqtr_green"
                        app:hintTextColor="@color/uqtr_green"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/uqtr_green">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAgentPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Bouton CONNEXION — doré -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CONNEXION"
                    android:textColor="@color/uqtr_white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/uqtr_gold" />

                <!-- Liens secondaires -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tvCreateAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Créer un compte"
                        android:textColor="@color/uqtr_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="14dp"
                        android:background="@color/text_secondary"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mot de passe oublié ?"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Note de bas de page -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trois-Rivières — Ville intelligente"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
