<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CitoyenActif" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="Theme.CitoyenActif.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Couleurs UQTR -->
        <item name="colorPrimary">@color/uqtr_green</item>
        <item name="colorPrimaryVariant">@color/uqtr_green_dark</item>
        <item name="colorOnPrimary">@color/uqtr_white</item>
        <item name="colorSecondary">@color/uqtr_gold</item>
        <item name="colorSecondaryVariant">@color/uqtr_gold_dark</item>
        <item name="colorOnSecondary">@color/uqtr_white</item>

        <!-- Fond général -->
        <item name="android:windowBackground">@color/uqtr_green</item>

        <!-- Couleurs texte par défaut -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Barre de statut verte UQTR -->
        <item name="android:statusBarColor">@color/uqtr_green_dark</item>
    </style>
</resources>